+  auto init = [&]() {
+    cudaDeviceProp prop;
+    NVTE_CHECK_CUDA(cudaGetDeviceProperties(&prop, device_id));
+    cache[device_id] = prop.warpSize;
+  };
+  std::call_once(flags[device_id], init);
+  return cache[device_id];
+}
