+        ]
+        out_avals = tuple(core.ShapedArray(a.shape, a.dtype) for a in ctx.avals_out)
+        # pylint: disable-next=unexpected-keyword-arg,missing-kwoa
+        launch = jax.jit(lambda *xs: prim.bind(*xs, out_avals=out_avals, rule=rule))
