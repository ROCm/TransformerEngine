 # Triton kernel cache (module-level, shared across all kernels)
 _TRITON_KERNEL_CACHE = {}
 
+# Process-scoped temp dir for ROCm HSACO blobs (removed at interpreter exit).
+_HSACO_TMPDIR = None
+_HSACO_TMPDIR_LOCK = threading.Lock()
