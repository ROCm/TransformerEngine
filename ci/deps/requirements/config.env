#
# Pins for the CI test environment that ci/install_deps.sh builds. The Python packages
# are listed in the .in files next to this one and pinned in ../locks/.

# GPU archs CI tests: one set of locks each, and Flash Attention kernels for all of them
GPU_ARCHS="gfx942 gfx950"

# Plain OS image the test container starts from
TE_CI_BASE_IMAGE=docker.io/library/ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852

# uv installs Python and every package; its version also fixes the Python patch release
UV_VERSION=0.13.9
UV_SHA256=a7fbaff2b9a271d85c1bdb540941090fd1ce011797b4abeb48e4dcd39c2471d5
PYTHON_VERSION=3.14

# Where uv gets packages besides PyPI: AMD's wheel index (ROCm and its builds of torch,
# Triton and JAX). Every source's versions count; the locks' sha256 pins keep the bytes exact.
UV_EXTRA_INDEX_URL=https://stable.repo.amd.com/rocm/whl-next
UV_INDEX_STRATEGY=unsafe-best-match

# Flash Attention depends on the exact torch, ROCm and Python, so it isn't in the locks:
# install_deps.sh installs this release's wheel built for the venv's, from the published
# ones or those ci/deps/build_fa_wheel.sh built here (see "Flash Attention" in ci/README.md)
FLASH_ATTN_VERSION=2.8.3.post2
FLASH_ATTN_WHEELS=https://compute-artifactory.amd.com/artifactory/rocm-generic-local/te-ci/fa-wheels/
FLASH_ATTN_LOCAL_WHEELS=/opt/fa-wheels

# aiter is installed from source. AITER_CK_COMMIT is the CK submodule commit that
# AITER_COMMIT pins; update_locks.sh refreshes it. 77455e3e was validated in CI for
# MXFP4 FP4 GEMM kernel coverage.
AITER_COMMIT=77455e3ecf4f0d28756afc452e914940c45b944b
AITER_CK_COMMIT=d5acfd8d5287082794158a60bc47264db06ef81f
